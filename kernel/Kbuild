obj-m += yukizygisk.o

yukizygisk-objs := \
	core/module.o \
	core/bootstrap.o \
	core/control.o \
	core/auth.o \
	core/viola_shared.o \
	core/viola_monocypher.o \
	core/viola_ed25519.o \
	host/runtime.o \
	host/root_impl.o \
	host/mount.o \
	host/policy.o \
	host/policy_temp.o \
	host/patch_text.o \
	host/lsm.o \
	host/adapter.o \
	feature/config.o \
	feature/load_policy.o \
	feature/safemode.o \
	feature/runtime.o \
	feature/early_native.o \
	feature/payload.o \
	feature/injector.o \
	feature/exec.o \
	feature/tango.o \
	feature/lifecycle.o \
	feature/events.o \
	feature/zygote_exit.o \
	feature/fd_handoff.o

ccflags-y += -I$(src)
VIOLA_BUILD_DIR ?= $(src)/../build/viola
ccflags-y += -I$(src)/../shared/viola -I$(VIOLA_BUILD_DIR)
CFLAGS_core/viola_shared.o += -std=gnu11
CFLAGS_core/viola_monocypher.o += -std=gnu11 -DVIOLA_NO_ARGON2
CFLAGS_core/viola_ed25519.o += -std=gnu11
ifneq ($(strip $(VIOLA_KMI_ID)),)
ccflags-y += -DVIOLA_KMI_ID=$(VIOLA_KMI_ID) -DVIOLA_BUILD_KMI=$(VIOLA_KMI_ID)
endif
ccflags-y += -I$(srctree)/security/selinux
ccflags-y += -I$(objtree)/security/selinux
ccflags-y += -I$(srctree)/security/selinux/include
ccflags-y += -I$(srctree)/security/selinux/ss
ccflags-y += -Wno-declaration-after-statement
ccflags-y += -Wno-missing-braces
ccflags-y += -Wno-unused-function
ccflags-y += -Wno-unused-variable

ifneq ($(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h; echo $$?),0)
ccflags-y += -DKSU_HAS_NEW_DCACHE_FLUSH
endif

ifneq ($(shell grep -A3 'sched_process_exit,' $(srctree)/include/trace/events/sched.h | grep -c 'bool group_dead'),0)
ccflags-y += -DYZ_EXIT_HAS_GROUP_DEAD
endif
