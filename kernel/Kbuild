obj-m += yukizygisk.o

yukizygisk-objs := \
	core/module.o \
	core/bootstrap.o \
	core/control.o \
	host/runtime.o \
	host/root_impl.o \
	host/mount.o \
	host/policy.o \
	host/policy_temp.o \
	host/patch_text.o \
	host/lsm.o \
	host/adapter.o \
	feature/zygote_probe.o \
	feature/tango.o \
	feature/zygote_orch.o \
	feature/zygote_nl.o \
	feature/zygote_ctl.o

ccflags-y += -I$(src)
ccflags-y += -I$(srctree)/security/selinux
ccflags-y += -I$(objtree)/security/selinux
ccflags-y += -I$(srctree)/security/selinux/include
ccflags-y += -I$(srctree)/security/selinux/ss
ccflags-y += -Wno-declaration-after-statement
ccflags-y += -Wno-missing-braces
ccflags-y += -Wno-unused-function
ccflags-y += -Wno-unused-variable

ifneq ($(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h; echo $$?),0)
ccflags-y += -DKSU_HAS_NEW_DCACHE_FLUSH
endif
